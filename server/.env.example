# À copier en `.env` (non versionné). Doit correspondre aux identifiants du .env
# racine utilisé par docker-compose.
DATABASE_URL="postgresql://supplier_eval:supplier_eval@localhost:5432/supplier_eval?schema=public"

PORT=3000
NODE_ENV=development

# Origine autorisée en CORS pour le frontend (Vite en dev)
CLIENT_URL="http://localhost:5173"

# Secret de signature JWT — à régénérer pour tout usage réel (ex: `openssl rand -hex 32`)
JWT_SECRET="dev-secret-change-me"
JWT_EXPIRES_IN="8h"
